# Nova Sonic (AWS Bedrock speech-to-speech). This app currently uses
# environment-based AWS credentials; EC2 instance-role lookup is not configured.
# For temporary STS credentials, provide the matching session token too.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-sonic-v1:0
BEDROCK_VOICE_ID=matthew
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# Nova Sonic USD rates per 1M tokens (Nova 2 Sonic defaults), used for cost_usd
# in ai_interviewer_llm_usage.
NOVA_SONIC_SPEECH_IN_PER_M=3.0
NOVA_SONIC_SPEECH_OUT_PER_M=12.0
NOVA_SONIC_TEXT_IN_PER_M=0.319
NOVA_SONIC_TEXT_OUT_PER_M=2.651
TEAMS_CLIENT_ID=
TEAMS_TENANT_ID=
TEAMS_CLIENT_SECRET=
TEAMS_USER_EMAIL=
TEAMS_USER_OBJECT_ID=
REDIRECT_URI=
DATABASE_URL=
REDIS_URL=

# Browser automation: set to false to watch the browser window locally
# (debugging only); leave true for normal/deployed headless operation.
BROWSER_HEADLESS=true
